[Unit]
Description=Refresh container-log-api host %i snapshot

[Service]
Type=oneshot
Group=65532
UMask=0027
NoNewPrivileges=yes
TimeoutStartSec=25s
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/lib/container-log-api/collect.py --output /var/lib/container-log-observer %i
